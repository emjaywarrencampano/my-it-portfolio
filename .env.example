# OpenRouter — get a key at https://openrouter.ai/keys
# Leave empty to run the assistant in deterministic, key-free mode.
OPENROUTER_API_KEY=

# Optional: comma-separated fallback chain of chat models.
# Defaults to a reliable free chain when unset.
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-26b-a4b-it:free,openrouter/free
